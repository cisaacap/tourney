<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" fx:id="rootPane" prefHeight="600.0" prefWidth="900.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.cisaacap.tourney.controller.dashboard.DashboardController">
    <stylesheets>
        <URL value="@/main/resources/css/dashboard/dashboard-view.css" />
    </stylesheets>
    <children>
        <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <BorderPane fx:id="mainBorderPane" prefHeight="600.0" prefWidth="900.0">
                    <top>
                        <VBox BorderPane.alignment="CENTER">
                            <children>
                                <HBox fx:id="windowHeader" alignment="CENTER_RIGHT" prefHeight="40.0" prefWidth="900.0" spacing="10.0" styleClass="window-header">
                                    <children>
                                        <Label styleClass="esports-title" text="TOURNEY DASHBOARD" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="userProfileButton" mnemonicParsing="false" onAction="#handleToggleSidebar" styleClass="window-btn-minimize" text="👤" />
                                        <Button fx:id="minimizeButton" mnemonicParsing="false" styleClass="window-btn-minimize" text="—" />
                                        <Button fx:id="closeButton" mnemonicParsing="false" styleClass="window-btn-close" text="✕" />
                                    </children>
                                    <padding>
                                        <Insets left="20.0" right="15.0" />
                                    </padding>
                                </HBox>
                            </children>
                        </VBox>
                    </top>
                    <center>
                        <VBox spacing="15.0" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets bottom="20.0" left="25.0" right="25.0" top="10.0" />
                            </padding>
                            <children>
                                <Label styleClass="esports-title" text="PARTIDOS PROGRAMADOS" />
                                <TableView fx:id="partidosTableView" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colDeporte" prefWidth="150.0" text="Torneo / Deporte" />
                                        <TableColumn fx:id="colEquipoLocal" prefWidth="180.0" text="Equipo Local" />
                                        <TableColumn fx:id="colPuntosLocal" prefWidth="90.0" text="Pts Local" />
                                        <TableColumn fx:id="colPuntosVisitante" prefWidth="90.0" text="Pts Visitante" />
                                        <TableColumn fx:id="colEquipoVisitante" prefWidth="180.0" text="Equipo Visitante" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </center>
                </BorderPane>

                <AnchorPane fx:id="overlayPane" mouseTransparent="false" pickOnBounds="false" prefHeight="600.0" prefWidth="900.0">
                    <children>
                        <Button fx:id="addActionButton" layoutX="820.0" layoutY="520.0" mnemonicParsing="false" onAction="#handleShowAddOptions" styleClass="esports-btn-primary, fab-button" text="+" AnchorPane.bottomAnchor="25.0" AnchorPane.rightAnchor="25.0">
                            <contextMenu>
                                <ContextMenu fx:id="addContextMenu">
                                    <items>
                                        <MenuItem mnemonicParsing="false" onAction="#handleCrearTorneo" text="➕ Crear Torneo" />
                                        <MenuItem mnemonicParsing="false" onAction="#handleCrearEquipo" text="👥 Crear Equipo" />
                                        <MenuItem mnemonicParsing="false" onAction="#handleCrearPartido" text="⨳ Crear Partido" />
                                    </items>
                                </ContextMenu>
                            </contextMenu>
                        </Button>

                        <VBox fx:id="sideBarContainer" alignment="TOP_CENTER" prefWidth="280.0" spacing="12.0" styleClass="esports-container-card" visible="false" AnchorPane.bottomAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="45.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>
                                <Label styleClass="esports-title" text="PERFIL DE JUGADOR" />
                                <Label fx:id="statusProfileLabel" style="-fx-text-fill: #4cc9f0; -fx-font-size: 11px;" text="" wrapText="true" />
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="esports-field-label" text="Nombre" />
                                        <TextField fx:id="nombreProfileField" styleClass="esports-text-field" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="esports-field-label" text="Apellido" />
                                        <TextField fx:id="apellidoProfileField" styleClass="esports-text-field" />
                                    </children>
                                </VBox>
                                <VBox spacing="4.0">
                                    <children>
                                        <Label styleClass="esports-field-label" text="Edad" />
                                        <TextField fx:id="edadProfileField" styleClass="esports-text-field" />
                                    </children>
                                </VBox>
                                <Button fx:id="saveProfileButton" mnemonicParsing="false" onAction="#handleGuardarPerfil" prefHeight="35.0" prefWidth="220.0" styleClass="esports-btn-primary" text="GUARDAR CAMBIOS" />
                                <Region VBox.vgrow="ALWAYS" />
                                <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" prefHeight="32.0" prefWidth="220.0" styleClass="window-btn-close" text="CERRAR SESIÓN" />
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>
            </children>
        </StackPane>
    </children>
</AnchorPane>