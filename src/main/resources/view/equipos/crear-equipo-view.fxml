<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="400.0" styleClass="esports-container-card" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.cisaacap.tourney.controller.dashboard.CrearEquipoController">
    <stylesheets>
        <URL value="@/main/resources/css/dashboard/dashboard-view.css" />
    </stylesheets>
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="15.0">
            <children>
                <HBox alignment="CENTER_RIGHT" prefHeight="30.0">
                    <children>
                        <Label styleClass="esports-title" text="CREAR NUEVO EQUIPO" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="closeButton" mnemonicParsing="false" onAction="#handleCancelar" styleClass="window-btn-close" text="✕" />
                    </children>
                </HBox>

                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="esports-field-label" text="Nombre del Equipo" />
                        <TextField fx:id="nombreEquipoField" promptText="Ej. Los Dragones" styleClass="esports-text-field" />
                    </children>
                </VBox>

                <VBox spacing="5.0">
                    <children>
                        <Label styleClass="esports-field-label" text="Ciudad" />
                        <TextField fx:id="ciudadField" promptText="Ej. Guatemala" styleClass="esports-text-field" />
                    </children>
                </VBox>

                <Label fx:id="statusLabel" alignment="CENTER" prefWidth="360.0" style="-fx-text-fill: #e63946; -fx-font-size: 11px;" text="" wrapText="true" />

                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCancelar" prefHeight="35.0" prefWidth="120.0" styleClass="window-btn-close" text="CANCELAR" />
                        <Button mnemonicParsing="false" onAction="#handleGuardarEquipo" prefHeight="35.0" prefWidth="150.0" styleClass="esports-btn-primary" text="GUARDAR" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>